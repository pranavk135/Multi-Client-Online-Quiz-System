[req]
default_bits       = 2048
prompt             = no
default_md         = sha256
distinguished_name = dn
x509_extensions    = v3_req

[dn]
C  = IN
ST = Karnataka
L  = Bangalore
O  = QuizNet
CN = QuizNet

[v3_req]
subjectAltName = @alt_names
basicConstraints = CA:FALSE
keyUsage = digitalSignature, keyEncipherment

[alt_names]
IP.1  = 127.0.0.1
DNS.1 = localhost
IP.2  = 192.168.56.1
